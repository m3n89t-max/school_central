# VAQ 센트럴 환경변수
#
# 공유용 템플릿. 실제 값은 넣지 말 것 — .env.local에 넣는다.
#
# !! 현재 Phase 1(목업 데모)은 외부 API를 하나도 쓰지 않는다.
#    아래 값들은 Phase 2 이후를 위해 미리 자리를 잡아둔 것이다.
#    "발급 필요"라고 적힌 건 아직 키가 없다는 뜻이다 — 임의의 값을 넣지 말 것.

# ─────────────────────────────────────────────────────────────
# 카카오 (지도)
# ─────────────────────────────────────────────────────────────
# JavaScript 키. 바탕화면/부동산/realestate 프로젝트에서 가져왔다.
# NEXT_PUBLIC_ 접두사가 붙으면 브라우저에 그대로 노출된다 — 카카오 JS SDK는
# 원래 그렇게 동작하며, 대신 개발자 콘솔의 "플랫폼 > Web 도메인" 등록으로 보호한다.
# 이 프로젝트에서 쓰려면 http://localhost:3000 을 등록해야 한다.
# 참고: Phase 1은 커스텀 벡터맵을 쓰므로 이 키를 아직 사용하지 않는다.
NEXT_PUBLIC_KAKAO_MAP_API_KEY=

# REST API 키. 주소 -> 좌표 변환(지오코딩)에 필요.
# 부동산 프로젝트 .env.local에도 설정돼 있지 않았다 → 발급 필요.
# https://developers.kakao.com 내 애플리케이션 > 앱 키
KAKAO_REST_API_KEY=

# ─────────────────────────────────────────────────────────────
# 공공데이터포털 (data.go.kr) — 발급 필요
# ─────────────────────────────────────────────────────────────
# 기상청 단기예보와 에어코리아는 서로 다른 기관 API지만,
# data.go.kr에서는 계정당 하나의 서비스키를 발급받아 각 API에 "활용신청"하는 구조다.
# 따라서 아래 두 값이 같은 문자열일 수 있다.
#
# 주의: 포털이 인코딩/디코딩 두 가지 형태로 키를 준다.
#       fetch에 쿼리스트링으로 직접 붙일 때는 보통 "디코딩" 키를 쓰고
#       URLSearchParams로 감싸면 자동 인코딩된다. 이중 인코딩되면 401이 난다.

# 기상청 단기예보 조회서비스 (온도·습도)
# 문서: https://www.data.go.kr/data/15084084/openapi.do
# 엔드포인트: https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
#   하위 오퍼레이션: getUltraSrtNcst(초단기실황) / getUltraSrtFcst(초단기예보) / getVilageFcst(단기예보)
# 이 키는 64자 hex라 URL 특수문자가 없다 → 인코딩/디코딩 키가 동일하고, 이중 인코딩 사고가 날 여지가 없다.
KMA_ENDPOINT=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_SERVICE_KEY=

# 에어코리아 (미세먼지 PM10 · 초미세먼지 PM2.5) — 활용신청 승인 2026-08-31 ~ 2028-08-31
# data.go.kr는 계정당 인증키가 하나다. 이 값은 KMA_SERVICE_KEY와 동일하다.
# 승인 전에는 같은 키로도 403 SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 났었다 —
# 키가 틀린 게 아니라 그 API에 활용신청이 안 돼 있다는 뜻이다.
AIRKOREA_ENDPOINT_AIR=https://apis.data.go.kr/B552584/ArpltnInforInqireSvc
AIRKOREA_ENDPOINT_STATION=https://apis.data.go.kr/B552584/MsrstnInfoInqireSvc
AIRKOREA_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# Supabase — 프로젝트 미생성
# ─────────────────────────────────────────────────────────────
# Phase 3에서 인증·DB·Realtime에 쓴다. https://supabase.com 프로젝트 생성 후
# Settings > API 에서 확인.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키는 절대 NEXT_PUBLIC_을 붙이지 않는다(RLS를 통째로 우회한다).
# 서버 라우트에서만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# LLM — 사용 여부 미정 (CLAUDE.md 6.1 AI 이상징후 멘트 / 6.3 AI 보고서)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
